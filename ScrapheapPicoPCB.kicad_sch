	(text "74LVC245A 5v -> 3.3v"
		(exclude_from_sim no)
		(at 210.566 152.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "95e4797e-7e86-415e-8ec5-d36c468e899a")
	)
	(text "74HCT245 3.3v -> 5v"
		(exclude_from_sim no)
		(at 266.446 158.496 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "990d8624-1787-4d7e-ab77-b6bce2cb75f3")
	)
	(text "POWER SUPPLY\n\n(VBUS) 5v Power in from USB 				\n(VSYS) 5v Power in externally\n(3V3_OUT) 3.3v Regulated by Pico for powering RP2040\n\n5v Ext Power In \n3.3v Regulated Board Power for logic and electronics.\n\nNeed a power input connector on the board (5v).\nThe Pico can generate its own 3.3v from this, but the \ninput needs to be protected with a shottkey diode to \nprevent backfeeding the USB as per datasheet PAGE 22\n(https://pip-assets.raspberrypi.com/categories/610-raspberry-pi-pico/documents/RP-008307-DS-2-pico-datasheet.pdf)\n\nI think the Pico can output 3.3 volts on pin 36 but only 300mA so will likely need an onboard regulator for 3.3v for\nthe multiplexer, shifters, rs485 etc as these can all run from 3.3v?\n\n"
		(exclude_from_sim no)
		(at 144.272 47.498 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a3d83c95-e852-4c38-80e9-9bbf9b876091")
	)
	(text "Buffered 5v input from Gearstick / Buttons\nBuffered 5v output to any LED strips\nBuffered 5v output to Relay"
		(exclude_from_sim no)
		(at 173.482 78.486 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "d970e2da-a7c0-4a9b-8bf1-920298c48d07")
	)
